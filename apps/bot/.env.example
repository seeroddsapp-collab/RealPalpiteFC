# Bot — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Supabase (SERVICE_ROLE_KEY — acesso total, apenas no servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (obter no BotFather: t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Mercado Pago — PIX depósitos e saques
# Obter em: https://www.mercadopago.com.br/developers/panel/app
# Variável obrigatória para /depositar e /sacar funcionarem
MP_ACCESS_TOKEN=

# Webhook PIX — token de segurança (gere qualquer string aleatória longa)
# Configure no Render como env var; use na URL do webhook no painel MP:
# Exemplo de URL: https://realpalpitefc.onrender.com/pix/webhook?token=SEU_TOKEN_AQUI
WEBHOOK_SECRET=

NODE_ENV=development
