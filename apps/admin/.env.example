# Admin — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores

# Supabase — cliente público (Auth, RLS, disponível no browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — servidor (operações administrativas, nunca expor ao browser)
SUPABASE_SERVICE_ROLE_KEY=

NODE_ENV=development
